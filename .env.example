# Postgres connection (Supabase, Neon, etc.). DIRECT_URL is used for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# Public URL of the site, used in emailed links.
NEXT_PUBLIC_SITE_URL="https://liftchristmas.org"

# Admin sign-in. Use a long password; SESSION_SECRET signs login cookies (32+ random chars).
ADMIN_PASSWORD=""
SESSION_SECRET=""

# Email (https://resend.com). Without a key, emails are printed to the server log instead.
RESEND_API_KEY=""
EMAIL_FROM="LIFT Community Christmas <christmas@liftchristmas.org>"
# Where new-application / new-sponsor alerts go.
ADMIN_NOTIFY_EMAIL=""

# Online donations (https://stripe.com). Without a key the Donate page shows mail-in instructions only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Protects /api/cron/* (Vercel sends this automatically as a Bearer token).
CRON_SECRET=""

# Shown on giving receipts / tax statements.
ORG_LEGAL_NAME="LIFT Community Christmas Ministry"
ORG_EIN=""
ORG_MAILING_ADDRESS=""
