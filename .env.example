# --- Database (Supabase) ---------------------------------------------------
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL: the "Transaction pooler" string (port 6543) with ?pgbouncer=true&connection_limit=1 added.
# DIRECT_URL:   the "Session pooler" or direct string (port 5432). Used for migrations.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Public URL of the site, used in emailed links (e.g. https://liftchristmas.org).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin sign-in -----------------------------------------------------------
# Use a long password. SESSION_SECRET signs login cookies: 32+ random characters.
ADMIN_PASSWORD=""
SESSION_SECRET=""

# Password Hannah enters to approve a family past the approval cap (Applications page).
CAP_OVERRIDE_PASSWORD=""

# --- Email (https://resend.com) --------------------------------------------
# Without a key, emails are printed to the server log instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="LIFT Community Christmas <christmas@liftchristmas.org>"
# Where new-application, gift, and thank-you-note alerts go.
ADMIN_NOTIFY_EMAIL=""

# --- Scheduled jobs ----------------------------------------------------------
# Any long random string. Netlify's scheduled functions send it to /api/cron/*.
CRON_SECRET=""

# --- Giving records ----------------------------------------------------------
ORG_LEGAL_NAME="LIFT Ministries"
ORG_EIN=""
ORG_MAILING_ADDRESS=""
# Leave false until the IRS recognizes LIFT Ministries as a 501(c)(3).
# While false, receipts say gifts are not tax-deductible.
ORG_TAX_EXEMPT="false"
